{
    "manifest_version":  3,
    "name":  "AI Job Application Assistant",
    "version":  "1.0.0",
    "description":  "Locally manage reusable job application profile data. Never submits forms automatically.",
    "permissions":  [
                        "storage"
                    ],
    "optional_host_permissions":  [
                                      "https://*/*",
                                      "http://localhost/*",
                                      "http://127.0.0.1/*"
                                  ],
    "action":  {
                   "default_popup":  "extension/popup/index.html",
                   "default_title":  "AI Job Application Assistant"
               },
    "options_page":  "extension/options/index.html",
    "content_scripts":  [
                            {
                                "matches":  [
                                                "http://*/*",
                                                "https://*/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "version_name":  "1.0.0-rc.1"
}
