{
    "name":  "ai-job-application-assistant",
    "version":  "1.0.0-rc.1",
    "private":  true,
    "description":  "A privacy-first Chrome extension for job application form assistance.",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc --noEmit \u0026\u0026 vite build \u0026\u0026 vite build --config vite.content.config.ts",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "preview":  "vite preview",
                    "lint":  "eslint .",
                    "e2e":  "corepack pnpm build \u0026\u0026 playwright test",
                    "privacy:check":  "node scripts/privacy-check.mjs",
                    "evaluate":  "tsx scripts/evaluate.ts",
                    "evaluate:ai":  "tsx scripts/evaluate-ai.ts"
                },
    "dependencies":  {
                         "@vitejs/plugin-react":  "4.3.4",
                         "react":  "18.3.1",
                         "react-dom":  "18.3.1",
                         "vite":  "6.1.0",
                         "zod":  "3.24.2"
                     },
    "devDependencies":  {
                            "@eslint/js":  "9.20.0",
                            "@playwright/test":  "1.50.1",
                            "@types/chrome":  "0.0.301",
                            "@types/jsdom":  "21.1.7",
                            "@types/node":  "22.13.1",
                            "@types/react":  "18.3.18",
                            "@types/react-dom":  "18.3.5",
                            "eslint":  "9.20.1",
                            "eslint-plugin-react-hooks":  "5.2.0",
                            "globals":  "15.14.0",
                            "jsdom":  "26.0.0",
                            "tsx":  "4.19.3",
                            "typescript":  "5.7.3",
                            "typescript-eslint":  "8.24.0",
                            "vitest":  "3.0.5"
                        },
    "packageManager":  "pnpm@9.15.5"
}
